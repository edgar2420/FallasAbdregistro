# Copia este archivo como .env y cambia los valores. El archivo .env NO se sube a GitHub.

# Dominio público que apunta a la IP del servidor (HTTPS automático con Let's Encrypt).
DOMINIO=fallas.tuempresa.com

# Red local de la planta, sin dominio:
#   - Sólo HTTP, más simple:        DOMINIO=:80
#   - HTTPS con certificado propio: DOMINIO=:443  y además  CADDYFILE=./Caddyfile.local
# (descomenta las líneas de abajo y comenta el DOMINIO de arriba)
# DOMINIO=:443
# CADDYFILE=./Caddyfile.local

# Contraseña inicial del usuario "admin" (mínimo 8 caracteres con letras y números).
# Sólo se usa la primera vez; el sistema obliga a cambiarla al ingresar.
ADMIN_PASSWORD=CambiaEsta2026
